# ══════════════════════════════════════════════════════════════════════
#  PsychroScan .gitignore
#  Rule: source code + example templates = public. Everything else = private.
# ══════════════════════════════════════════════════════════════════════

# ── Python Environments & Bytecode ────────────────────────────────────
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ── Backups & Editor Swap Files ───────────────────────────────────────
*.bak
*.bak_*
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs & Tooling ────────────────────────────────────────────────────
.vscode/
.idea/
.spyderproject
.spyproject

# ── Raw & Processed Data (Reproducible via scripts) ───────────────────
data/raw/
data/processed/
data/reference_panel/
data/Done/
data/new_genomes/

# ── Private Configuration & Taxon IP ──────────────────────────────────
# config/taxa_list_example.json IS tracked for open reproducibility
config/taxa_list.json
config/*.bak*

# ── Trained Models & Serialized Checkpoints ───────────────────────────
results/models/*.pkl
results/models/*.txt
results/models/split_manifest.json

# ── Embargoed Results, Figures & Reports ──────────────────────────────
results/figures/
results/benchmark/
results/reports/
results/supplementary/
results/taxa_list_*.json
results/top15_*.csv
top15_*.csv

# ── Logs & Temporary Execution Data ───────────────────────────────────
*.log
logs/
.system_generated/